<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <!-- Make pages render at device width on mobile -->
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Dashboard</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .alert.success { background: #d4edda; color: #155724; padding: 10px; border-radius: 4px; margin: 10px 0; }
    .alert.error   { background: #f8d7da; color: #721c24; padding: 10px; border-radius: 4px; margin: 10px 0; }
  </style>
</head>
<body>

  <!-- Show session message if present -->
  <% if (message) { %>
    <div class="alert <%= message.type %>">
      <%= message.text %>
    </div>
  <% } %>

  <!-- Header: single flex row so bell never wraps -->
  <main class="page-content">
    <header class="header">
      <div class="logo">
        <img src="/source/logo.png" alt="Logo" class="logo">
      </div>
      <div class="brand">CHAINX</div>
      <div class="search-bar">
        <i class="fas fa-bars"></i>
        <input type="text" placeholder="Search">
        <i class="fas fa-search"></i>
      </div>
      <i class="fas fa-bell notification-icon"></i>
    </header>



    <div class="stats">
      <div class="card">
        <i class="fas fa-dollar-sign"></i>
        <p>BALANCE<br><strong>$<%= balance %></strong></p>
      </div>
      <div class="card">
        <i class="fas fa-wallet"></i>
        <p>Monthly CashIn<br><strong>$<%= monthlyCashIn %></strong></p>
      </div>
      <div class="card">
        <i class="fas fa-sack-dollar"></i>
        <p>Monthly CashOut<br><strong>$<%= monthlyCashOut %></strong></p>
      </div>
    </div>

    <div class="feature-grid">
      <a href="/withdraw" class="feature-item">
        <div class="icon-circle"><i class="fas fa-money-bill-wave"></i></div>
        <span>Withdraw</span>
      </a>
      <a href="/deposit" class="feature-item">
        <div class="icon-circle"><i class="fas fa-coins"></i></div>
        <span>Deposit</span>
      </a>
      <a href="/event" class="feature-item">
        <div class="icon-circle"><i class="fas fa-receipt"></i></div>
        <span>Events</span>
      </a>
      <a href="/checkin" class="feature-item">
        <div class="icon-circle"><i class="fas fa-clipboard-check"></i></div>
        <span>Daily Check-in</span>
      </a>
      <a href="/order" class="feature-item">
        <div class="icon-circle"><i class="fas fa-cart-plus"></i></div>
        <span>Order</span>
      </a>
      <a href="/service" class="feature-item">
        <div class="icon-circle"><i class="fas fa-clipboard-list"></i></div>
        <span>Service</span>
      </a>
      <a href="/aboutus" class="feature-item">
        <div class="icon-circle"><i class="fas fa-coins"></i></div>
        <span>About Us</span>
      </a>
      <a href="/faq" class="feature-item">
        <div class="icon-circle"><i class="fas fa-receipt"></i></div>
        <span>FAQs</span>
      </a>
    </div>

    <!-- TradingView Widget BEGIN -->
<!-- TradingView Widget BEGIN -->
<div class="tradingview-widget-container" style="height:100%;width:100%">
  <div class="tradingview-widget-container__widget" style="height:calc(100% - 32px);width:100%"></div>
  <div class="tradingview-widget-copyright"><a href="https://www.tradingview.com/symbols/BINANCE-BTCUSDT/?exchange=BINANCE" rel="noopener nofollow" target="_blank"><span class="blue-text">BTCUSDT chart by TradingView</span></a></div>
  <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js" async>
  {
  "allow_symbol_change": true,
  "calendar": false,
  "details": false,
  "hide_side_toolbar": true,
  "hide_top_toolbar": false,
  "hide_legend": false,
  "hide_volume": false,
  "hotlist": false,
  "interval": "D",
  "locale": "en",
  "save_image": true,
  "style": "1",
  "symbol": "BINANCE:BTCUSDT",
  "theme": "dark",
  "timezone": "Etc/UTC",
  "backgroundColor": "#0F0F0F",
  "gridColor": "rgba(242, 242, 242, 0.06)",
  "watchlist": [],
  "withdateranges": false,
  "compareSymbols": [],
  "studies": [],
  "autosize": true
}
  </script>
</div>
<!-- TradingView Widget END -->

    <div style="margin:20px;">
      <h2 style="text-align:center;">Market Overview</h2>
      <%- include('partials/market-table', { markets, showTitle: false }) %>
    </div>
  </main>

  <!-- Include footer partial directly (no extra wrapper) -->
  <%- include('partials/footer', { active: 'dashboard' }) %>
</body>
</html>