<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Markets</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
  
<body>
  <header class="header">
    <div class="logo"><img src="/source/logo.png" alt="Logo" class="logo"></div>
    <div class="brand">CHAINX</div>
    <div class="search-bar">
      <i class="fas fa-bars"></i>
      <input type="text" placeholder="Search">
      <i class="fas fa-search"></i>
    </div>
    <i class="fas fa-bell notification-icon"></i>
  </header>

  <div style="padding:12px 16px; margin:0 auto; text-align:center;">
    <h2>Markets</h2>
  </div>

  <main class="market-page">
    <!-- ⬇️ Use the shared partial instead of the inline table -->
    <%- include('partials/market-table', { markets, showTitle: false }) %>
  </main>

  <%- include('partials/footer', { active: 'market' }) %>
</body>
</html>
