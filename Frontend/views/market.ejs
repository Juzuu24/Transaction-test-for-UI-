<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Make pages render at device width on mobile -->
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

  <title>Markets</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
  
<body>
  <header class="header">
    <div class="logo"><img src="/source/logo.png" alt="Logo" class="logo"></div>
    <div class="brand">CHAINX</div>
    <div class="search-bar">
      <i class="fas fa-bars"></i>
      <input type="text" placeholder="Search">
      <i class="fas fa-search"></i>
    </div>
    <i class="fas fa-bell notification-icon"></i>
  </header>

  <div style="padding:12px 16px; margin:0 auto; text-align:center;">
    <h2>Markets</h2>
  </div>

 <main class="market-page">
  <!-- TradingView Market Overview Widget BEGIN -->
  <div class="tradingview-widget-container" style="margin-bottom:24px;">
    <div class="tradingview-widget-container__widget"></div>
    <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-market-overview.js" async>
    {
      "colorTheme": "light",
      "dateRange": "12M",
      "showChart": false,
      "locale": "en",
      "width": "100%",
      "height": "120",
      "largeChartUrl": "",
      "isTransparent": false,
      "showSymbolLogo": true,
      "plotLineColorGrowing": "rgba(41, 98, 255, 1)",
      "plotLineColorFalling": "rgba(41, 98, 255, 1)",
      "gridLineColor": "rgba(240, 243, 250, 0)",
      "scaleFontColor": "rgba(120, 123, 134, 1)",
      "belowLineFillColorGrowing": "rgba(41, 98, 255, 0.12)",
      "belowLineFillColorFalling": "rgba(41, 98, 255, 0.12)",
      "symbolActiveColor": "rgba(41, 98, 255, 0.12)",
      "tabs": [
        {
          "title": "Stocks",
          "symbols": [
            { "s": "NASDAQ:AAPL", "d": "Apple" },
            { "s": "NASDAQ:GOOGL", "d": "Google" },
            { "s": "NASDAQ:MSFT", "d": "Microsoft" }
          ],
          "originalTitle": "Stocks"
        },
        {
          "title": "Forex",
          "symbols": [
            { "s": "FX:EURUSD", "d": "EUR/USD" },
            { "s": "FX:USDJPY", "d": "USD/JPY" }
          ],
          "originalTitle": "Forex"
        }
      ]
    }
    </script>
  </div>
  <!-- TradingView Market Overview Widget END -->

  <%- include('partials/market-table', { markets, showTitle: false }) %>
</main>

  <%- include('partials/footer', { active: 'market' }) %>
</body>
</html>
